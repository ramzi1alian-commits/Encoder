<resources>
    <!--
        DAY (light-mode) palette. android:theme is DayNight, so Android
        swaps these for values-night/colors.xml automatically when the
        user picks night mode.

        FIXED IN THIS PASS: the old day palette was pure neutral slate-gray
        (#F1F5F9 / #E2E8F0 / #CBD5E1 / #64748B ...) with almost zero color
        saturation, which is exactly what reads as "faded/dusty" on
        screen - there was no hue to it at all, just gray-on-gray. Every
        neutral below now carries a slight blue tint (still clearly a
        "neutral", not a colored background) and the light/dark ends of
        the scale are pushed further apart (closer to true white and a
        much deeper text color) for sharper, higher-contrast edges
        instead of a washed-out low-contrast look.
    -->
    <color name="navy_950">#F5F9FF</color>
    <color name="navy_900">#FFFFFF</color>
    <color name="navy_800">#E9F1FC</color>
    <color name="navy_700">#B9D4EF</color>
    <color name="slate_400">#4F6B8A</color>
    <color name="slate_200">#0B1F33</color>
    <color name="white">#071729</color>

    <!--
        Accent colors are shared by both day and night (not overridden
        below) - these were the main source of the "dusty" look, since
        accent_purple in particular (#A78BFA) is a pale, low-saturation
        pastel. All four are now pushed to fully-saturated, high-contrast
        hues instead of muted/pastel tones.
    -->
    <color name="accent_cyan">#00D3FF</color>
    <color name="accent_cyan_dark">#0086B3</color>
    <color name="danger_red">#FF4D4D</color>

    <color name="accent_teal">#00E6B8</color>
    <color name="accent_gold">#FFC107</color>
    <color name="accent_purple">#9B4DFF</color>

    <!--
        Fixed (NOT overridden in values-night) dark color for text that
        sits on top of a bright accent-colored button background. Button
        fills are always the bright accent color in both day and night
        mode, so the text on them must always stay dark - it must NOT
        follow navy_950's day/night flip, or day mode would render
        near-invisible light text on a bright cyan/gold/etc button.
    -->
    <color name="text_on_accent">#071729</color>

    <color name="navy_50_light">#F5F9FF</color>
    <color name="white_card">#FFFFFF</color>

    <color name="colorPrimary">@color/navy_900</color>
    <color name="colorPrimaryDark">@color/navy_950</color>
    <color name="colorAccent">@color/accent_cyan</color>
</resources>
