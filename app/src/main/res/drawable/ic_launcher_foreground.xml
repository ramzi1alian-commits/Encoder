<?xml version="1.0" encoding="utf-8"?>
<!--
    New professional foreground glyph: a shield (security) with a small
    keyboard-row cue inside, in dark navy with a cyan accent lock - reads
    clearly against the new light background at every launcher size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield outline -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M54,22 L80,32 L80,55 C80,71 69,83 54,88 C39,83 28,71 28,55 L28,32 Z" />

    <!-- Inner shield face, lighter, so the shield reads as an outlined
         badge rather than a solid block -->
    <path
        android:fillColor="#F1F5F9"
        android:pathData="M54,28 L74,36 L74,55 C74,68 65,78 54,82 C43,78 34,68 34,55 L34,36 Z" />

    <!-- Small keyboard-row glyph inside the shield, three key dots -->
    <path android:fillColor="#0F172A" android:pathData="M42,50 h8 v8 h-8 z" />
    <path android:fillColor="#0F172A" android:pathData="M50,50 h8 v8 h-8 z" />
    <path android:fillColor="#0F172A" android:pathData="M58,50 h8 v8 h-8 z" />
    <path android:fillColor="#0F172A" android:pathData="M42,62 h24 v6 h-24 z" />

    <!-- Accent lock badge at the top of the shield -->
    <path
        android:fillColor="#0891B2"
        android:pathData="M54,30 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
