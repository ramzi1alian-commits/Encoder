<?xml version="1.0" encoding="utf-8"?>
<!--
    New LIGHT launcher background (previously a solid dark navy fill).
    A soft slate-white base gives the icon a clean, professional look on
    the home screen and reads clearly at small sizes, while the shield
    stays in the dark navy for contrast.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#F1F5F9"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Subtle inner tint so flat light backgrounds don't look empty on
         adaptive-icon masks that crop close to the edges. -->
    <path
        android:fillColor="#E2E8F0"
        android:pathData="M0,72 h108 v36 h-108 z" />
</vector>
